# Environment variables
# Copy this file to .env and adjust as needed:  cp .env.example .env

SECRET_KEY="django-insecure-dev-key-please-change-in-production"
ENV_TYPE="dev"
SERVER_LOG_PATH="server.log"
SECURITY_AUDIT_LOG_PATH="security_audit.log"
SECURE_SSL_REDIRECT="False"
SESSION_COOKIE_SECURE="False"
CSRF_COOKIE_SECURE="False"
TRUST_X_FORWARDED_PROTO="False"
DEBUG=True
DOMAIN_NAME="http://localhost:8000"
SWAGGER_ROOT_URL="http://localhost:8000"

# AWS (only needed for production / S3 storage)
AWS_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SES_REGION_NAME=""
AWS_SES_REGION_ENDPOINT=""

# DB
DBNAME="crm_db"
DBUSER="postgres"
DBPASSWORD="postgres"
DBHOST="localhost"
DBPORT="5432"

# Local Docker host bindings. Keep these on loopback while testing real
# integration credentials; use an authenticated reverse proxy for deployment.
BACKEND_HOST_PORT="8000"
FRONTEND_HOST_PORT="5173"

# Sentry (optional)
SENTRY_DSN=""

# Celery
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Google OAuth (optional — leave blank to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta Lead Ads (optional until the Facebook integration is enabled)
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""
# Dedicated WhatsApp verification token; falls back to META_WEBHOOK_VERIFY_TOKEN.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
META_GRAPH_API_VERSION="v25.0"
META_GRAPH_API_BASE_URL="https://graph.facebook.com"
META_GRAPH_API_TIMEOUT="10"
META_OAUTH_DIALOG_URL="https://www.facebook.com/v25.0/dialog/oauth"
META_OAUTH_REDIRECT_URI="http://localhost:8000/api/integrations/facebook/oauth/callback/"
META_OAUTH_FRONTEND_REDIRECT_URL="http://localhost:5173/settings/facebook"
META_OAUTH_STATE_TTL="900"
META_OAUTH_SCOPES="pages_show_list,pages_manage_metadata,leads_retrieval"

# Platform-owned OpenAI key used only when a tenant enables the SDR inspector.
OPENAI_API_KEY=""
OPENAI_API_BASE_URL="https://api.openai.com/v1"
OPENAI_API_TIMEOUT_SECONDS="30"
OPENAI_ALLOWED_MODELS="gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol"
OPENAI_ALLOWED_REASONING_EFFORTS="none,low,medium"
DOUBAO_API_KEY=""
DOUBAO_API_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
DOUBAO_API_TIMEOUT_SECONDS="30"
DOUBAO_ALLOWED_MODELS="doubao-seed-2-0-lite-260215"
DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE_URL="https://api.deepseek.com"
DEEPSEEK_API_TIMEOUT_SECONDS="30"
DEEPSEEK_ALLOWED_MODELS="deepseek-v4-flash,deepseek-v4-pro"
AI_GATEWAY_ALLOW_TENANT_KEYS="True"
AI_GATEWAY_ALLOWED_REASONING_EFFORTS="none,low,medium"
# Required in production. Generate one Fernet key outside the application,
# store it in the deployment secret manager, and keep it stable across deploys.
# Local development may leave this blank and derive a key from SECRET_KEY.
INTEGRATION_ENCRYPTION_KEY=""

# Apollo automatic prospect sources. Tenant API keys are encrypted in the DB.
APOLLO_API_BASE_URL=https://api.apollo.io/api/v1
APOLLO_API_TIMEOUT=15
LINKEDIN_API_BASE_URL=https://api.linkedin.com
LINKEDIN_API_TIMEOUT=10
FEISHU_OPEN_API_BASE_URL=https://open.feishu.cn
FEISHU_OPEN_API_TIMEOUT=15
AUTOMATION_RETRY_BASE_SECONDS="5"
AUTOMATION_RETRY_MAX_SECONDS="900"
AUTOMATION_JOB_LEASE_SECONDS="600"
AUTOMATION_MANUAL_RETRY_ATTEMPTS="3"
SDR_FEISHU_TIMEOUT_SECONDS="5"

# Email (use "django.core.mail.backends.console.EmailBackend" for dev, "django_ses.SESBackend" for AWS SES)
EMAIL_BACKEND="django.core.mail.backends.console.EmailBackend"
DEFAULT_FROM_EMAIL="noreply@localhost"
ADMIN_EMAIL="admin@localhost"

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
